<?xml version="1.0" encoding="UTF-8"?>

<!-- Root element of the Maven project -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Version of the Maven POM model -->
    <modelVersion>4.0.0</modelVersion>


    <!--
        Spring Boot parent POM.
        It provides default Maven configuration and manages
        compatible dependency versions.
    -->
    <parent>

        <!-- Organization that provides Spring Boot -->
        <groupId>org.springframework.boot</groupId>

        <!-- Parent POM provided by Spring Boot -->
        <artifactId>spring-boot-starter-parent</artifactId>

        <!-- Spring Boot version -->
        <version>3.5.6</version>

        <!-- Do not look for the parent POM in the local project -->
        <relativePath/>

    </parent>


    <!-- Identifies our application -->
    <groupId>com.hsbc.account</groupId>

    <!-- Name of the application/JAR -->
    <artifactId>account-service</artifactId>

    <!-- Application version -->
    <version>1.0.0</version>


    <!-- Human-readable application name -->
    <name>account-service</name>

    <!-- Description of the application -->
    <description>Account Service for Banking Application</description>


    <!-- Project-level properties -->
    <properties>

        <!-- Java version used to compile the application -->
        <java.version>17</java.version>

        <!-- JaCoCo version used for code coverage -->
        <jacoco.version>0.8.13</jacoco.version>

        <!-- SonarQube project identifier -->
        <sonar.projectKey>account-service</sonar.projectKey>

    </properties>


    <!-- Libraries required by the application -->
    <dependencies>


        <!-- Provides Spring MVC and REST API support -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>


        <!-- Provides application health endpoints,
             including readiness and liveness endpoints -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>


        <!-- Provides Spring Data JPA for database access -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>


        <!-- MySQL JDBC driver used to connect to MySQL -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>

            <!-- Required at runtime, not for compiling application code -->
            <scope>runtime</scope>
        </dependency>


        <!-- Provides Spring Security functionality -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>


        <!-- Provides validation such as @Valid and @NotNull -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>


        <!-- Provides testing support such as JUnit and Mockito -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>

            <!-- Used only during testing -->
            <scope>test</scope>
        </dependency>


    </dependencies>


    <!-- Maven build configuration -->
    <build>

        <!-- Maven plugins used during the build -->
        <plugins>


            <!-- Creates/runs the Spring Boot executable JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>


            <!-- Generates code coverage information -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>

                <!-- JaCoCo plugin version -->
                <version>${jacoco.version}</version>


                <!-- Defines when JaCoCo should execute -->
                <executions>


                    <!-- Attach JaCoCo agent before tests start -->
                    <execution>
                        <id>prepare-agent</id>

                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>


                    <!-- Generate the JaCoCo coverage report -->
                    <execution>
                        <id>report</id>

                        <!-- Run this execution during the verify phase -->
                        <phase>verify</phase>

                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>


                </executions>

            </plugin>


        </plugins>

    </build>

</project>
